---
import wordmark from "../assets/agent-gopi-wordmark.png";
import gopi from "../assets/agent-gopi.png";
import Landing from "../layouts/Landing.astro";
import CodeFrame from "../components/CodeFrame.astro";

const base = import.meta.env.BASE_URL;
const docs = `${base.replace(/\/$/, "")}/docs/`;

// Layout rules are documented in web/DESIGN.md.

const firstCall = `
model := ai.LanguageModel{
    Model:    anthropic.Sonnet5,
    Provider: anthropic.New(anthropic.APIKey(key)),
}

messages := []ai.Message{
    ai.UserMessage("Say hello in one sentence."),
}

msg, err := model.StreamText(ctx, messages).Wait()

fmt.Println(msg.Text())`;

const streamCode = `
stream := model.StreamText(ctx, messages,
    ai.SystemPrompt([]ai.Content{ai.Text{Text: "Answer in one sentence."}}),
    ai.Thinking(ai.ThinkingHigh),
    ai.MaxTokens(1024),
)

for event, err := range stream.Events() {
    switch event.Type {
    case ai.EventTextDelta:
        io.WriteString(w, event.Delta)
    }
}

msg, err := stream.Wait()
fmt.Println(msg.Usage.Output, msg.StopReason)`;

const toolCode = `
weather := tool.New(
    "get_weather",
    func(ctx context.Context, in WeatherIn) (WeatherOut, error) {
        return WeatherOut{Temp: "22°C"}, nil
    },
    tool.Description("Get the current weather for a city"),
)

tools := ai.Tools([]ai.ToolInfo{weather.Info()})

msg, err := model.StreamText(ctx, messages, tools).Wait()

for _, call := range msg.ToolCalls() {
    result, err := weather.Run(ctx, call)
    messages = append(messages,
        ai.ToolResultMessage(call.ID, result.Content...),
    )
}`;

const hooksCode = `
a := agent.New(model,
    agent.Toolset(listIssues, readIssue, closeIssue),

    // Fail a run that loops.
    agent.BeforeCall(func(
        ctx context.Context, s agent.State, r agent.Request,
    ) (agent.Request, error) {
        if s.Turn() > 20 {
            return r, errors.New("the run used too many turns")
        }
        return r, nil
    }),

    // Block a call. The model reads the reason.
    agent.BeforeTool(func(
        ctx context.Context, s agent.State, c ai.ToolCall,
    ) (ai.ToolCall, error) {
        if c.Name == "close_issue" {
            return c, agent.Deny("ask a maintainer to close issues")
        }
        return c, nil
    }),

    // Continue a run that stops before it posts a summary.
    agent.BeforeStop(func(
        ctx context.Context, s agent.State,
    ) ([]session.Entry, error) {
        if posted(s.Messages()) {
            return nil, nil
        }
        return []session.Entry{session.Text("Post the summary first.")}, nil
    }),
)`;

const agentCode = `
a := agent.New(model, agent.Toolset(weather))

stream := a.Run(ctx, session.Text("Is it warmer in Lisbon or in Oslo?"))
for event, err := range stream.Events() {
    if err != nil {
        log.Fatal(err)
    }
    switch e := event.(type) {
    case agent.EventToolExecutionStart:
        fmt.Println("->", e.ToolName, string(e.Args))
    case agent.EventMessageUpdate:
        if e.AssistantEvent.Type == ai.EventTextDelta {
            fmt.Print(e.AssistantEvent.Delta)
        }
    }
}`;

const durableCode = `
store, err := jsonl.New("sessions")

a, err := agent.Durable(ctx, model, "triage",
    agent.Store(store),
    agent.Toolset(listIssues, readIssue),
)

// With no input, the run continues from the last message.
var input []session.Entry
if len(os.Args) > 1 {
    input = append(input, session.Text(os.Args[1]))
}

stream := a.Run(ctx, input...)
for event, err := range stream.Events() {
    if err != nil {
        log.Fatal(err)
    }
    if e, ok := event.(agent.EventToolExecutionStart); ok {
        fmt.Println("->", e.ToolName, string(e.Args))
    }
}

msgs, err := stream.Wait()
fmt.Println(msgs[len(msgs)-1].Text())`;

const providers = [
  ["anthropic", "http", "key", "the Messages API", "pkg/ai/anthropic"],
  ["openai", "http", "key", "the Responses API", "pkg/ai/openai"],
  ["openaichat", "http", "key", "the Chat Completions API", "pkg/ai/openaichat"],
];
---

<Landing
  title="gopi: AI agents in Go"
  description="Build AI agents in Go with model calls, typed tools, and streamed events."
>
  {/* ============ HERO ============ */}
  <header class="row hero agent-hero">
    <div class="row-inner">
      <div class="cell cell--words">
        <p class="label">Go SDK / AI agents</p>
        <h1><img class="hero-wordmark" src={wordmark.src} alt="agent gopi" width={wordmark.width} height={wordmark.height} fetchpriority="high" /></h1>
        <p class="hero-description">Build AI agents in Go.</p>
        <p class="lede">
          Call a model, give it Go functions as tools, and let an agent run the loop. A
          session keeps the history, so the agent picks up where it stopped.
        </p>

        <div class="install">
          <span class="sig">$</span>
          <code>go get github.com/sonnes/gopi</code>
          <button class="copy" data-copy aria-label="Copy the command">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
              <rect x="5.5" y="5.5" width="8" height="8"></rect>
              <path d="M10.5 2.5h-8v8"></path>
            </svg>
          </button>
        </div>

        <p class="hero-actions">
          <a class="btn btn--primary" href={`${docs}start/`}>Get started</a>
          <a class="more" href="https://github.com/sonnes/gopi">View on GitHub</a>
        </p>
      </div>

      <figure class="agent-portrait">
        <img src={gopi.src} alt="Agent Gopi, a golden gopher in a cream trench coat, with sunglasses and a coral tie." width={gopi.width} height={gopi.height} loading="eager" fetchpriority="high" />
        <figcaption class="label"><span>agent gopi</span><span>001 / undercover</span></figcaption>
      </figure>
    </div>
  </header>

  {/* ============ 01 · a pair ============ */}
  <section class="row" id="session">
    <div class="row-inner">
      <div class="cell cell--words">
        <p class="label">pkg/agent · durable</p>
        <h2>Durable Agents in Go</h2>
        <p>
          <code>agent.Durable</code> opens a session by its ID. The log stores each message
          before its event, so a crash loses at most the message in flight.
        </p>
        <p>
          Each tool result is stored when its call ends. A call that a crash cut short gets
          an error result, and the next run continues from there.
        </p>
        <a class="more" href={`${docs}guides/keep-a-session/`}>Keep a session</a>
      </div>
      <div class="cell cell--work">
        <CodeFrame path="triage.go" code={durableCode}>
          <pre class="shell shell--out"><span class="p">$</span> go run ./triage.go "Triage the open issues"
{`-> list_issues {"state":"open"}
-> read_issue {"number":41}
-> read_issue {"number":42}`}
signal: killed
<span class="p">$</span> go run ./triage.go
{`-> read_issue {"number":42}`}
Two issues are open: #41 is a bug, #42 asks for a feature.</pre>
        </CodeFrame>
      </div>
    </div>
  </section>

  {/* ============ 02 · a pair ============ */}
  <section class="row" id="agent">
    <div class="row-inner">
      <div class="cell cell--words">
        <p class="label">pkg/agent · the loop</p>
        <h2>An Agent Runs the Loop</h2>
        <p>
          <code>Run</code> calls the model, runs each tool call, and calls the model again,
          until the model answers without a tool call.
        </p>
        <p>
          Each step is a typed event on one stream, so a UI can show the run as it
          happens.
        </p>
        <a class="more" href={`${docs}agent/`}>Read about agents</a>
      </div>
      <div class="cell cell--work">
        <CodeFrame path="agent.go" code={agentCode}>
          <pre class="shell shell--out"><span class="p">$</span> go run ./agent.go
{`-> weather {"city":"Lisbon"}
-> weather {"city":"Oslo"}`}
Lisbon is warmer: 21 degrees against 9.</pre>
        </CodeFrame>
      </div>
    </div>
  </section>

  {/* ============ 03 · a pair ============ */}
  <section class="row" id="hooks">
    <div class="row-inner">
      <div class="cell cell--words">
        <p class="label">pkg/agent · hooks</p>
        <h2>Change the Loop With Hooks</h2>
        <p>
          A hook runs at one point of the loop: before a model call, before or after a tool
          call, after a turn, or before the run stops. It reads a copy of the state.
        </p>
        <p>
          The hooks run in the order that you add them.
          An error from a <code>BeforeTool</code> hook blocks the call, and the model reads
          the reason.
        </p>
        <a class="more" href={`${docs}agent/hooks/`}>Read about hooks</a>
      </div>
      <div class="cell cell--work">
        <CodeFrame path="hooks.go" code={hooksCode} />
      </div>
    </div>
  </section>

  {/* ============ 04 · a pair ============ */}
  <section class="row" id="tools">
    <div class="row-inner">
      <div class="cell cell--words">
        <p class="label">pkg/tool · tools</p>
        <h2>A Tool Is a Go Function</h2>
        <p>
          <code>tool.New</code> takes a Go function and derives the JSON schema from its
          input type. The function receives the typed input.
        </p>
        <p>
          An agent runs each tool call for you.
          Without an agent, <code>ai.Tools</code> declares the tools on one model call,
          and your code runs the calls.
        </p>
        <a class="more" href={docs}>Read the documentation</a>
      </div>
      <div class="cell cell--work">
        <CodeFrame path="tools.go" code={toolCode} />
      </div>
    </div>
  </section>

  {/* ============ 05 · a pair ============ */}
  <section class="row" id="first-call">
    <div class="row-inner">
      <div class="cell cell--words">
        <p class="label">pkg/ai · one call</p>
        <h2>Call a Model Without an Agent</h2>
        <p>
          Under the agent is one model call. Build a prompt, bind a model to a provider,
          and read the answer.
        </p>
        <a class="more" href={`${docs}start/`}>Make your first call</a>
      </div>
      <div class="cell cell--work">
        <CodeFrame path="first_call.go" code={firstCall}>
          <pre class="shell shell--out"><span class="p">$</span> go run ./first_call.go
Hello! How can I help you today?</pre>
        </CodeFrame>
      </div>
    </div>
  </section>

  {/* ============ 06 · a pair ============ */}
  <section class="row" id="stream">
    <div class="row-inner">
      <div class="cell cell--words">
        <p class="label">pkg/ai · streams</p>
        <h2>One Prompt, One Stream</h2>
        <p>
          <code>StreamText</code> returns at once. The stream yields typed events as the
          model writes, and <code>Wait</code> returns the final message with its usage.
        </p>
        <p>
          An option is a typed setter. A later value wins, and a provider reads only the
          options that it knows. Cancel the call through its context.
        </p>
        <a class="more" href={docs}>Read the documentation</a>
      </div>
      <div class="cell cell--work">
        <CodeFrame path="stream.go" code={streamCode} />
      </div>
    </div>
  </section>

  {/* ============ 07 · the width of the sheet ============ */}
  <section class="row row--wide" id="providers">
    <div class="wide-inner">
      <div class="wide-head">
        <div>
          <p class="label">pkg/ai · providers</p>
          <h2>The Provider Contract Is One Method</h2>
        </div>
        <div class="wide-note">
          <p>
            <code>ai.TextProvider</code> requires one method: <code>StreamText</code>. A
            provider that also generates objects or counts tokens implements a second
            interface, and the binding asserts it.
          </p>
          <a class="more" href={docs}>Read the documentation</a>
        </div>
      </div>

      <figure class="artifact">
        <figcaption class="label">providers</figcaption>
        <table class="ledger">
          <colgroup><col /><col /><col /><col /><col /></colgroup>
          <thead>
            <tr>
              <th>provider</th><th>transport</th><th>auth</th><th>it drives</th><th>package</th>
            </tr>
          </thead>
          <tbody>
            {
              providers.map(([id, transport, auth, upstream, pkg]) => (
                <tr>
                  <td class="mono">{id}</td>
                  <td class="mono dim">{transport}</td>
                  <td class="mono dim">{auth}</td>
                  <td class="mono dim">{upstream}</td>
                  <td class="mono dim">{pkg}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </figure>
    </div>
  </section>

  {/* ============ THE WAY OUT ============ */}
  <section class="outro">
    <div class="outro-inner">
      <p class="label">the documentation</p>
      <a class="outro-link" href={docs}>Read the documentation</a>
      <p class="outro-lede">Start with the overview, or open the guide for your job.</p>
      <ul class="ways-out">
        <li><a href={docs}>Overview</a><span>what gopi is</span></li>
        <li><a href={`${docs}start/`}>Get Started</a><span>install gopi and make one call</span></li>
        <li><a href={`${docs}ai/`}>The Layer</a><span>the types of one model call</span></li>
        <li><a href={`${docs}agent/`}>Agents</a><span>the loop of model calls and tools</span></li>
        <li><a href={`${docs}session/`}>Sessions</a><span>the history that an agent resumes</span></li>
        <li><a href={`${docs}guides/call-a-model/`}>The Guides</a><span>one page for each job</span></li>
      </ul>
    </div>
  </section>
</Landing>
