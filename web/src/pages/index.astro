---
import wordmark from "../assets/agent-gopi-wordmark.png";
import gopi from "../assets/agent-gopi.png";
import Landing from "../layouts/Landing.astro";
import CodeFrame from "../components/CodeFrame.astro";
import { snippet } from "../snippet.mjs";
import durableSrc from "../../../examples/landing/durable.go?raw";
import hostSrc from "../../../examples/landing/host.go?raw";
import customizeSrc from "../../../examples/landing/customize.go?raw";
import demo from "../data/demo.json";

const base = import.meta.env.BASE_URL;
const docs = `${base.replace(/\/$/, "")}/docs/`;
const godoc = "https://pkg.go.dev/github.com/sonnes/gopi";

// Layout rules are documented in web/DESIGN.md. Each snippet comes from
// examples/landing, which the Go toolchain builds. A band shows a preview
// of the code and links the docs page of what it shows. The events come
// from a real run: make site-demo records them.

const bands = [
  {
    id: "hooks",
    label: "pkg/agent · hooks",
    title: "Change the Loop With Hooks",
    words: [
      "A hook runs at one point of the loop. A denied call does not run, and the model reads the reason.",
      "A BeforeStop hook keeps the run going until the work is done.",
    ],
    more: ["Read about hooks", `${docs}agent/hooks/`],
    path: "hooks.go",
    caption: "a guard and a stop check",
    code: snippet(customizeSrc, "hooks"),
  },
];

// The places where an agent of gopi runs, for the section on Agent Gopi.
const covers = [
  ["coding agent", "a terminal", "harness.New"],
  ["issue triage", "a nightly job", "agent.Durable"],
  ["code reviewer", "a CI step", "harness.Builtin(harness.ReadOnly)"],
  ["support agent", "an HTTP handler", "h.Stream"],
  ["Claude Code or Codex", "a page of your app", "claude-code/, codex/"],
];

// A long call in the covers table wraps after its open parenthesis, not
// inside a name.
const breakAfterParen = (s: string) => s.replaceAll("(", "(<wbr>");

// The sessions of one host, each over its own workspace, for fig. 1.
const sessions = [
  { id: "fix-login", dir: "repos/app", agent: "claude-code", status: "running" },
  { id: "notes", dir: "repos/site", agent: "codex", status: "requires_action" },
  { id: "nightly", dir: "repos/api", agent: "harness", status: "idle", reason: "restarted" },
];

// The lifecycle of a session: each status, and the call or the event
// that moves it on.
const lifecycle = [
  { status: "idle", via: "Send" },
  { status: "running", via: "a call waits" },
  { status: "requires_action", via: "Confirm" },
  { status: "running", via: "the model stops" },
  { status: "idle" },
];
const stops = [
  ["end_turn", "the model answered"],
  ["interrupted", "Interrupt ended the run"],
  ["error", "the run failed"],
  ["restarted", "the process stopped, and Open recovered the session"],
];

// The two parts of a model spec, for the figure of the providers band.
const specParts = [
  { text: "claude-code", hue: "harness", name: "driver", note: "claude-code and codex start their CLI. A provider, such as anthropic, runs on the harness." },
  { text: "/", hue: null },
  { text: "claude-opus-5-5", hue: "ai", name: "model", note: "from models.json, or from the models that the CLI lists" },
];
const specs = [
  ["anthropic/claude-opus-5-5", "the loop in your process"],
  ["claude-code/claude-opus-5-5", "the Claude Code CLI"],
  ["codex/gpt-6-astra", "the Codex CLI"],
];

// The events of the resumed run, with the deltas of one message as one
// row. Each row has a kind for its hue and a depth for its indent.
interface RecordedEvent {
  type: string;
  tool?: string;
  role?: string;
}
interface EventRow {
  type: string;
  kind: string;
  depth: number;
  detail?: string;
  count: number;
}
const DEPTH: Record<string, number> = { agent: 0, turn: 1 };

function eventRows(events: RecordedEvent[]): EventRow[] {
  const rows: EventRow[] = [];
  for (const e of events) {
    const last = rows.at(-1);
    if (e.type === "message_update" && last?.type === "message_update") {
      last.count++;
      continue;
    }
    const kind = e.type.split("_")[0];
    const detail = e.tool ?? (e.role === "tool_result" ? "tool result" : e.role);
    rows.push({ type: e.type, kind, depth: DEPTH[kind] ?? 2, detail, count: 1 });
  }
  return rows.map((r) =>
    r.type === "message_update" ? { ...r, detail: `${r.count} deltas` } : r,
  );
}
const events = eventRows(demo.events);

const layers = [
  { id: "host", pkg: "pkg/host", page: "host/", what: "Runs the lifecycle of each session over its workspace: the status, the calls that wait for a person, and the recovery after a restart.", lives: "the program", crash: "Each session that ran is idle, with the stop reason restarted.", hue: "harness" },
  { id: "harness", pkg: "pkg/harness", page: "harness/", what: "Assembles a coding agent at each start: the instructions of AGENTS.md, skills, subagents, coding tools, MCP servers, a sandbox, and the permission rules.", lives: "one start of an agent", crash: "Assembles the agent again from its files.", hue: "harness" },
  { id: "agent", pkg: "pkg/agent", page: "agent/", what: "Runs the loop: a model call, the tool calls, and the hooks at each point, until the model stops.", lives: "while your program holds it", crash: "The next run continues the log.", hue: "agent" },
  { id: "session", pkg: "pkg/session", page: "session/", what: "Keeps the log of a session in a store. Each message is stored before its event.", lives: "until you remove it", crash: "Loses at most the message in flight.", hue: "durable" },
  { id: "tool", pkg: "pkg/tool", page: "tool/", what: "Turns a Go function into a tool with a typed input. MCP servers add more tools.", lives: "one tool call", crash: "A call that a crash cut short gets an error result.", hue: "wire" },
  { id: "ai", pkg: "pkg/ai", page: "ai/", what: "Makes one model call: messages and options in, a stream of events and a message out.", lives: "one request", crash: "Gone. The caller calls again.", hue: "ai" },
];

// The guide of each layer. The nouns sit beside its slab. The note says
// what to use the layer for, when to skip it, and the APIs that a
// program calls first.
interface Guide {
  nouns: string[];
  use: string[];
  skip: string;
  apis: string[][];
}
const guide: Record<string, Guide> = {
  host: {
    nouns: ["Host", "Session", "Config", "Status"],
    use: [
      "A product that runs many sessions, such as a web app or a chat bot.",
      "A page where a person approves the tool calls of an agent.",
      "Sessions that come back after a deploy or a crash.",
    ],
    skip: "One program runs one session. Use agent.Durable.",
    apis: [
      ["host.Open", "a host over a store"],
      ["h.Create", "an idle session from a host.Config"],
      ["h.Send", "starts a run, or steers it"],
      ["h.Confirm", "allows or denies a waiting call"],
      ["h.Stream", "the events of one session"],
      ["h.Interrupt", "stops the active run"],
    ],
  },
  harness: {
    nouns: ["Harness", "Option", "Builtins", "Mode"],
    use: [
      "A coding agent over a repository.",
      "An agent that a team changes through files: AGENTS.md, skills, and subagents.",
      "A permission mode and rules for each tool call.",
    ],
    skip: "The code gives the tools and the prompt, and no files. Use agent.New.",
    apis: [
      ["harness.New", "a harness from options"],
      ["h.Durable", "an agent bound to a stored session"],
      ["harness.Defs", "folders of AGENTS.md, skills/, and agents/"],
      ["harness.MCP", "MCP servers, connected at each start"],
      ["harness.Mode", "the permission mode of each call"],
      ["harness.Deny", "a rule for the calls that never run"],
    ],
  },
  agent: {
    nouns: ["Agent", "Event", "Hook", "Decision"],
    use: [
      "Your own loop in your process, on any provider.",
      "Hooks around each model call and each tool call.",
      "A job that continues after a crash, with agent.Durable.",
    ],
    skip: "One model call needs no tools. Use StreamText.",
    apis: [
      ["agent.New", "an agent with a log in memory"],
      ["agent.Durable", "an agent bound to a session"],
      ["a.Run", "one pass of the loop, as a stream"],
      ["a.Steer", "entries for the next model call"],
      ["agent.BeforeTool", "a hook before each tool call"],
      ["agent.Deny", "blocks a call, with a reason"],
    ],
  },
  session: {
    nouns: ["Log", "Entry", "Value[T]", "Storer"],
    use: [
      "A record of the work that outlives the process.",
      "App state next to the messages, with session.Value.",
      "A store of your own, such as a database, behind session.Storer.",
    ],
    skip: "An agent has agent.Store. The agent writes the log.",
    apis: [
      ["session.Open", "creates a session, or resumes it"],
      ["l.Append", "adds entries to the log"],
      ["session.Value[T]", "app state next to the entries"],
      ["session.Storer", "the interface of a store"],
      ["storefs.Sessions", "a store of JSONL files"],
    ],
  },
  tool: {
    nouns: ["Tool", "Middleware"],
    use: [
      "A Go function that the model can call.",
      "Code around each call, such as a log, a retry, or a denial.",
      "Many tools that load only when the model searches for them.",
    ],
    skip: "The tools come from an MCP server. Give the server to harness.MCP.",
    apis: [
      ["tool.New", "a tool from a Go function"],
      ["tool.Description", "the text that the model reads"],
      ["tool.Defer", "a tool that loads on demand"],
      ["tool.Wrap", "a tool with a new run function"],
      ["tool.Chain", "middleware around a tool"],
    ],
  },
  ai: {
    nouns: ["LanguageModel", "Message", "ToolCall", "Usage"],
    use: [
      "One model call, such as a reply, a summary, or a label.",
      "A typed value from a model, with GenerateObject.",
      "A provider of your own behind one interface.",
    ],
    skip: "The model calls tools in a loop. Use pkg/agent.",
    apis: [
      ["lm.StreamText", "one model call, as a stream"],
      ["ai.GenerateObject", "a typed value from a model"],
      ["ai.CountTokens", "the input tokens, before a call"],
      ["ai.Message", "a role and its content"],
      ["ai.TextProvider", "the interface of a provider"],
    ],
  },
};

const providers = [
  ["anthropic", "provider", "API key", "pkg/ai/anthropic"],
  ["openai", "provider", "API key", "pkg/ai/openai"],
  ["openaichat", "provider", "API key", "pkg/ai/openaichat"],
  ["chatgpt", "provider", "ChatGPT sign-in", "pkg/ai/chatgpt"],
  ["fireworks", "provider", "API key", "pkg/ai/fireworks"],
  ["openrouter", "provider", "API key", "pkg/ai/openrouter"],
  ["claude-code", "driver", "CLI login", "pkg/agent/claude"],
  ["codex", "driver", "CLI login", "pkg/agent/codex"],
];

const waysOut = [
  ["Overview", "", "the layers, and where to start"],
  ["Sessions", "session/", "the log that an agent resumes"],
  ["Host", "host/", "sessions of any agent by ID"],
  ["Agents", "agent/", "the loop, hooks, and events"],
  ["CLI Agents", "agent/cli/", "Claude Code and Codex as agents"],
  ["Harness", "harness/", "a coding agent from its files"],
  ["Tools", "tool/", "a Go function the model calls"],
  ["Model Call", "ai/", "one call, its stream, and its message"],
];
---

<Landing
  title="gopi: durable agents in Go"
  description="Run your own loop, Claude Code, or Codex as a durable session in your Go program."
>
  {/* ============ HERO ============ */}
  <header class="row hero agent-hero">
    <div class="row-inner">
      <div class="cell cell--words">
        <p class="label">Go SDK · durable agents</p>
        <h1>Durable agents in Go.</h1>
        <p class="lede">
          Run your own loop, Claude Code, or Codex as a session in your Go program. If
          the process stops, the next run continues from the last stored message.
        </p>

        <p class="hero-actions">
          <a class="btn btn--primary" href={docs}>Get started</a>
          <a class="more" href={`${docs}session/`}>Read about sessions</a>
        </p>
      </div>

      <div class="cell cell--work">
        <CodeFrame path="triage.go" caption="a durable agent" code={snippet(durableSrc, "durable")} />
      </div>
    </div>
  </header>

  {/* ============ harness ============ */}
  <section class="row" id="harness">
    <div class="row-inner">
      <div class="cell cell--words">
        <p class="label">pkg/harness · options</p>
        <h2>Build Your Own Harness</h2>
        <p>
          A harness turns a repository into an agent. Each part of the agent is one option:
          change one and keep the rest. The sessions go to any store: JSONL files, or your
          own store over SQLite or Postgres.
        </p>
        <p>
          The harness assembles the agent again at each start, so an edit to a skill reaches
          the next agent.
        </p>
        <a class="more" href={`${docs}harness/`}>Read about the harness</a>
      </div>
      <div class="cell cell--work">
        <CodeFrame path="claude.go" caption="a harness like Claude Code" code={snippet(customizeSrc, "harness")} />
      </div>
    </div>
  </section>

  {/* ============ managed agents ============ */}
  <section class="row" id="host">
    <div class="row-inner">
      <div class="cell cell--words">
        <p class="label">pkg/host · sessions</p>
        <h2>Managed Agents</h2>
        <p>
          A host runs the lifecycle of each session: it starts the agent, runs one message
          at a time, waits for a person, and recovers the session after a restart.
        </p>
        <p>
          Each session pairs an agent with a workspace: the folder that it works in, and
          the folders of its AGENTS.md, skills, and subagents. The model spec picks the
          agent: the harness, Claude Code, or Codex.
        </p>
        <a class="more" href={`${docs}host/`}>Read about the host</a>
      </div>
      <div class="cell cell--work">
        <CodeFrame path="host.go" caption="two sessions over two workspaces" code={snippet(hostSrc, "host")} />
        <figure class="cycle">
          <table class="cycle-sessions">
            <thead><tr><th>session</th><th>workspace</th><th>agent</th><th>status</th></tr></thead>
            <tbody>
              {
                sessions.map((x) => (
                  <tr>
                    <td>{x.id}</td>
                    <td>{x.dir}</td>
                    <td>{x.agent}</td>
                    <td><span class={`status status--${x.status}`}>{x.reason ? `${x.status} · ${x.reason}` : x.status}</span></td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <ol class="cycle-track" aria-label="The lifecycle of a session">
            {
              lifecycle.map((c) => (
                <li>
                  <span class={`status status--${c.status}`}>{c.status}</span>
                  {c.via && <span class="cycle-via">{c.via}</span>}
                </li>
              ))
            }
          </ol>
          <dl class="cycle-stops">
            {stops.map(([reason, text]) => (<><dt>idle · {reason}</dt><dd>{text}</dd></>))}
          </dl>
          <figcaption class="label"><span>fig. 1</span><span>sessions and their lifecycle</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  {/* ============ hooks ============ */}
  {
    bands.map((b) => (
      <section class="row" id={b.id}>
        <div class="row-inner">
          <div class="cell cell--words">
            <p class="label">{b.label}</p>
            <h2>{b.title}</h2>
            {b.words.map((t) => <p>{t}</p>)}
            <a class="more" href={b.more[1]}>{b.more[0]}</a>
          </div>
          <div class="cell cell--work">
            <CodeFrame path={b.path} caption={b.caption} code={b.code} />
          </div>
        </div>
      </section>
    ))
  }

  {/* ============ events ============ */}
  <section class="row" id="events">
    <div class="row-inner">
      <div class="cell cell--words">
        <p class="label">pkg/agent · events</p>
        <h2>Show Each Step of a Run</h2>
        <p>
          Each step of a run is a typed event on one stream, so a page can show the run as
          it happens.
        </p>
        <p>The harness, Claude Code, and Codex send the same events.</p>
        <a class="more" href={`${docs}agent/events/`}>Read about events</a>
      </div>
      <div class="cell cell--work">
        <CodeFrame path="events.go" caption="a page that streams a run" code={snippet(customizeSrc, "events")} />
        <figure class="events" data-events>
          <ol class="event-rows">
            {
              events.map((e) => (
                <li class={`event event--${e.kind}`} style={`--depth: ${e.depth}`} data-event>
                  <code>{e.type}</code>
                  {e.detail && <span>{e.detail}</span>}
                </li>
              ))
            }
          </ol>
          <figcaption class="label"><span>fig. 2</span><span>the events of the resumed run</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  {/* ============ layers ============ */}
  <section class="row row--wide" id="layers">
    <div class="wide-inner">
      <div class="wide-head">
        <div>
          <p class="label">the stack</p>
          <h2>Use Any Layer Without the Layers Above It</h2>
        </div>
        <div class="wide-note">
          <p>
            Each layer calls only the layers under it. The session is the one layer that a
            crash does not end.
          </p>
        </div>
      </div>

      <div class="stack">
        {
          layers.map((l, i) => (
            <input class="stack-radio" type="radio" name="layer" id={`layer-${l.id}`} checked={i === 0} />
          ))
        }
        <div class="stack-bars">
          {
            layers.map((l) => (
              <label class={`stack-bar stack-bar--${l.id}`} for={`layer-${l.id}`} style={`--hue: var(--l-${l.hue})`}>
                <svg class="slab" viewBox="0 0 280 160" aria-hidden="true">
                  <path class="slab-left" d="M2 70 L140 139 L140 158 L2 89 Z" />
                  <path class="slab-right" d="M140 139 L278 70 L278 89 L140 158 Z" />
                  <path class="slab-top" d="M140 2 L278 70 L140 139 L2 70 Z" />
                </svg>
                <span class="stack-name">
                  {l.pkg}
                  <span class="stack-nouns">
                    {guide[l.id].nouns.map((n, i, all) => (
                      <>
                        <span>{n}{i < all.length - 1 && " ·"}</span>{" "}
                      </>
                    ))}
                  </span>
                </span>
              </label>
            ))
          }
        </div>
        <div class="stack-notes">
          {
            layers.map((l) => (
              <div class={`stack-note stack-note--${l.id}`} style={`--hue: var(--l-${l.hue})`}>
                <p class="stack-pkg">{l.pkg}</p>
                <p class="stack-what">{l.what}</p>
                <div class="uses">
                  <p class="cards-head">use it for</p>
                  <ul>{guide[l.id].use.map((u) => <li>{u}</li>)}</ul>
                  <p class="uses-skip"><span>skip it when</span>{guide[l.id].skip}</p>
                </div>
                <div class="cards">
                  <p class="cards-head">start with</p>
                  <ul>
                    {guide[l.id].apis.map(([name, what]) => (
                      <li class="card"><code>{name}</code><span>{what}</span></li>
                    ))}
                  </ul>
                </div>
                <dl>
                  <dt>lives for</dt><dd>{l.lives}</dd>
                  <dt>after a crash</dt><dd>{l.crash}</dd>
                </dl>
                <a class="more" href={`${docs}${l.page}`}>Read about {l.pkg}</a>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* ============ providers and drivers ============ */}
  <section class="row row--wide" id="providers">
    <div class="wide-inner">
      <div class="wide-head">
        <div>
          <p class="label">pkg/ai · pkg/agent</p>
          <h2>Providers and Drivers</h2>
        </div>
        <div class="wide-note">
          <p>
            A provider serves a model call. A driver starts an agent. A model spec names
            one of them and a model. A spec with no driver runs on the harness.
          </p>
          <a class="more" href={`${docs}providers/write-a-provider/`}>Write a provider</a>
        </div>
      </div>

      <figure class="spec-fig">
        <div class="spec" aria-hidden="true">
          {
            specParts.map((p) => (
              <span class="spec-part" style={p.hue ? `--hue: var(--l-${p.hue})` : undefined}>
                <span class="spec-text">{p.text}</span>
                {p.name && <span class="spec-note"><b>{p.name}</b>{p.note}</span>}
              </span>
            ))
          }
        </div>
        <ul class="spec-routes">
          {specs.map(([spec, where]) => <li><code>{spec}</code><span>{where}</span></li>)}
        </ul>
        <figcaption class="label"><span>fig. 3</span><span>the model spec</span></figcaption>
      </figure>

      <figure class="artifact">
        <figcaption class="label">spec prefixes</figcaption>
        <table class="ledger ledger--providers">
          <colgroup><col /><col /><col /><col /></colgroup>
          <thead>
            <tr><th>prefix</th><th>kind</th><th>auth</th><th>package</th></tr>
          </thead>
          <tbody>
            {
              providers.map(([id, kind, auth, pkg]) => (
                <tr>
                  <td class="mono">{id}</td>
                  <td class="dim">{kind}</td>
                  <td class="dim">{auth}</td>
                  <td class="mono"><a href={`${godoc}/${pkg}`}>{pkg}</a></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </figure>
    </div>
  </section>

  {/* ============ agent gopi ============ */}
  <section class="row agent-band" id="agent-gopi">
    <div class="row-inner">
      <div class="cell cell--words agent-id">
        <img class="agent-wordmark" src={wordmark.src} alt="agent gopi" width={wordmark.width} height={wordmark.height} loading="lazy" />
        <figure class="agent-portrait">
          <img src={gopi.src} alt="Agent Gopi, a golden gopher in a cream trench coat, with sunglasses and a coral tie." width={gopi.width} height={gopi.height} loading="lazy" />
          <figcaption class="label"><span>agent gopi</span><span>001 / undercover</span></figcaption>
        </figure>
      </div>
      <div class="cell cell--work">
        <p class="label">agent gopi · cover identities</p>
        <h2>Agent Gopi Can Be Any Agent in Your Code</h2>
        <p class="agent-lede">
          An agent is a value in your Go program. It runs where your code runs, with the
          tools and the rules that you give it.
        </p>
        <table class="ledger ledger--covers">
          <thead><tr><th>cover</th><th>runs in</th><th>built with</th></tr></thead>
          <tbody>
            {covers.map(([cover, where, parts]) => (<tr><td>{cover}</td><td class="dim">{where}</td><td class="mono" set:html={breakAfterParen(parts)} /></tr>))}
          </tbody>
        </table>
        <a class="more" href={`${docs}agent/`}>Read about agents</a>
      </div>
    </div>
  </section>

  {/* ============ THE WAY OUT ============ */}
  <section class="outro">
    <div class="outro-inner">
      <p class="label">the documentation</p>
      <a class="outro-link" href={docs}>Read the documentation</a>
      <p class="outro-lede">Start with the overview, or open the page for your job.</p>
      <ul class="ways-out">
        {
          waysOut.map(([name, page, note]) => (
            <li><a href={`${docs}${page}`}>{name}</a><span>{note}</span></li>
          ))
        }
      </ul>
    </div>
  </section>

  <script is:inline>
    // The events light up in order, once, when the figure comes into
    // view. Without JavaScript, the page shows every event.
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const EVENT_MS = 140;
    document.querySelectorAll("[data-events]").forEach((fig) => {
      if (still) return;
      const rows = [...fig.querySelectorAll("[data-event]")];
      const seen = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting) return;
        seen.disconnect();
        rows.forEach((r) => r.classList.add("is-dim"));
        rows.forEach((r, i) => setTimeout(() => r.classList.remove("is-dim"), (i + 1) * EVENT_MS));
      });
      seen.observe(fig);
    });
  </script>
