---
// A code window in the style of xdb.dev: a tab bar with the file name and
// what the snippet shows, then the code. src/highlight.mjs colours the
// comments and the strings, and leaves the rest as ink.
import { highlight } from "../highlight.mjs";

interface Props {
  path: string;
  caption?: string;
  code: string;
}

const { path, caption, code } = Astro.props;
---

<div class="win">
  <div class="win-tab">{caption ? `${path}  ·  ${caption}` : path}</div>
  <pre><code set:html={highlight(code.trim())} /></pre>
</div>
