---
// A type chain: the types that a program passes through, with each
// method call on the arrow between two types. Two inputs join into one
// binding. A call on the binding starts a chain that runs left to right,
// one type per step. A dotted branch under the first type of the chain
// shows a path that the chain skips. Use it to read a short program as
// a series of type changes.
//
// The layout is computed from the width of the mono face, 0.6em for
// each character, so a longer type name moves the boxes and the arrows
// with it.
import Figure from "./Figure.astro";

type Kind = "plain" | "wire" | "assistant" | "accent";

interface Box {
  type: string;
  note?: string;
  kind?: Kind;
}

interface Props {
  alt: string;
  caption?: string;
  // inputs are joined by a bracket into the binding.
  inputs: Box[];
  // join labels the arrow from the bracket to the binding.
  join: string;
  binding: Box;
  // call labels the arrow from the binding to the first type of the chain.
  call: string;
  // chain is the types after the call. via labels the arrow into a type.
  chain: (Box & { via?: string })[];
  // branch is the dotted path under the first type of the chain.
  branch?: { text: string; note?: string };
}

const { alt, caption, inputs, join, binding, call, chain, branch } = Astro.props;

const ch = (px: number) => px * 0.6;
const H = 46; // the height of a box: the type and one note line
const PAD = 22; // the padding and the border of a box, on both sides

const width = (b: Box) =>
  Math.ceil(Math.max(b.type.length * ch(12), (b.note ?? "").length * ch(10.5)) + PAD);

type Placed = Box & { x: number; y: number; w: number; h: number };

// The inputs, in a column at the left. They share one width.
const inW = Math.max(...inputs.map(width));
const ins: Placed[] = inputs.map((b, i) => ({ ...b, x: 0, y: i * (H + 12), w: inW, h: H }));
const inTop = H / 2;
const inBottom = ins[ins.length - 1].y + H / 2;
const inMid = (inTop + inBottom) / 2;

// The bracket, then the arrow into the binding.
const brX = inW + 30;
const bindX = inW + 76;
const bind: Placed = { ...binding, x: bindX, y: inMid - H / 2, w: width(binding), h: H };

// The chain, one row under the binding.
const chainY = Math.max(ins[ins.length - 1].y, bind.y) + H + 56;
let x = 0;
const links: { x1: number; x2: number; via: string }[] = [];
const row: Placed[] = chain.map((b, i) => {
  if (i > 0) {
    const gap = Math.max(56, Math.ceil((b.via ?? "").length * ch(11.5)) + 16);
    links.push({ x1: x, x2: x + gap - 4, via: b.via ?? "" });
    x += gap;
  }
  const p = { ...b, x, y: chainY, w: width(b), h: H };
  x += p.w;
  return p;
});
const first = row[0];

// The call runs from the foot of the binding to the head of the chain.
const callY = chainY - 30;
const bindC = bind.x + bind.w / 2;
const firstC = first.x + first.w / 2;

const branchY = chainY + H + 14;
const W = Math.max(bind.x + bind.w, x, 0);
const Ht = branch ? branchY + 26 : chainY + H;

const boxClass = (k?: Kind) => ["tb", "node", k === "wire" ? "k-tool" : k === "assistant" ? "k-assistant" : k === "accent" ? "accent" : ""];
const all: Placed[] = [...ins, bind, ...row];
---

<Figure alt={alt} caption={caption}>
  <div class="cv" style={`width:${W}px;height:${Ht}px`}>
    <svg viewBox={`0 0 ${W} ${Ht}`} width={W} height={Ht} aria-hidden="true">
      <path class="edge" d={`M${inW},${inTop} H${brX} V${inBottom} H${inW}`} />
      <path class="edge" d={`M${brX},${inMid} H${bindX - 4}`} />
      <path class="head" d={`M${bindX - 9},${inMid - 4} L${bindX - 1},${inMid} L${bindX - 9},${inMid + 4} z`} />
      <text x={(brX + bindX) / 2} y={inMid - 6} text-anchor="middle" class="n">{join}</text>

      <path class="edge" d={`M${bindC},${bind.y + H} V${callY} H${firstC} V${chainY - 4}`} />
      <path class="head" d={`M${firstC - 4},${chainY - 9} L${firstC},${chainY - 1} L${firstC + 4},${chainY - 9} z`} />
      <text x={(bindC + firstC) / 2} y={callY - 6} text-anchor="middle" class="m">{call}</text>

      {
        links.map((l) => (
          <>
            <path class="edge" d={`M${l.x1},${chainY + H / 2} H${l.x2}`} />
            <path class="head" d={`M${l.x2 - 5},${chainY + H / 2 - 4} L${l.x2 + 3},${chainY + H / 2} L${l.x2 - 5},${chainY + H / 2 + 4} z`} />
            <text x={(l.x1 + l.x2) / 2} y={chainY + H / 2 - 6} text-anchor="middle" class="m">{l.via}</text>
          </>
        ))
      }

      {branch && <path class="edge dot" d={`M${firstC},${chainY + H} V${branchY}`} />}
    </svg>
    {
      all.map((b) => (
        <div class:list={boxClass(b.kind)} style={`left:${b.x}px;top:${b.y}px;width:${b.w}px;height:${b.h}px`}>
          {b.type}
          {b.note && <small>{b.note}</small>}
        </div>
      ))
    }
    {
      branch && (
        <>
          <div class="tb node k-ephemeral eph" style={`left:0;top:${branchY}px;width:${first.w}px`}>
            {branch.text}
          </div>
          {branch.note && (
            <span class="side" style={`left:${first.w + 12}px;top:${branchY + 3}px`}>
              {branch.note}
            </span>
          )}
        </>
      )
    }
  </div>
</Figure>

<style>
  .cv {
    position: relative;
    margin: 0 auto;
  }
  .cv > svg {
    position: absolute;
    inset: 0;
  }
  .cv .node.tb {
    position: absolute;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 10px;
    line-height: 1.35;
    white-space: nowrap;
  }
  .tb small {
    font-size: 10.5px;
    color: var(--muted);
  }
  .cv .tb.eph {
    height: 24px;
    font-size: 11px;
  }
  .side {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: var(--label-track);
    color: var(--muted);
    white-space: nowrap;
  }
  .cv svg .m {
    font-size: 11.5px;
    font-weight: 600;
    fill: var(--text);
  }
  .cv svg .n {
    font-size: 10.5px;
    fill: var(--muted);
  }
  .cv svg .edge.dot {
    stroke-dasharray: 2 3;
  }
</style>
