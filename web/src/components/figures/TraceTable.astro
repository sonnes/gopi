---
// A turn-by-turn trace of one run: one row per message that the run
// adds, grouped by turn, with an optional author column. One column per
// model call shows what the call reads (a bar over the rows before it)
// and the row that it writes (an arrow). Use it for a run where the
// order of the messages and what each call reads matter.
import Figure from "./Figure.astro";
import CallCode from "./CallCode.astro";

type Kind = "user" | "assistant" | "tool" | "meta" | "ephemeral" | "error" | "value";

interface Row {
  id: string;
  kind: Kind;
  // who is a muted word before the text, such as "calls" or "weather:".
  who?: string;
  text?: string;
  // chips are [text, kind] pairs after the text, such as tool calls.
  chips?: [string, Kind][];
  // stop is an accent word at the end, such as "no tool call".
  stop?: string;
  // author fills the author column. If no row has an author, the
  // table has no author column.
  author?: string;
}

interface Turn {
  label: string;
  rows: Row[];
}

interface Props {
  alt: string;
  caption?: string;
  call: string;
  turns: Turn[];
  // calls lists the ID of the row that each model call writes. A call
  // reads every row above that row.
  calls: string[];
  // entryLabel heads the message column. authorLabel heads the author
  // column.
  entryLabel?: string;
  authorLabel?: string;
}

const {
  alt,
  caption,
  call,
  turns,
  calls,
  entryLabel = "message",
  authorLabel = "author",
} = Astro.props;

const rows = turns.flatMap((t) => t.rows);
const written = calls.map((id) => rows.findIndex((r) => r.id === id));
const hasAuthor = rows.some((r) => r.author);
// first is the grid column of the first model call.
const first = hasAuthor ? 4 : 3;
const authorCol = hasAuthor ? "96px " : "";
const cols = `54px minmax(0, 1fr) ${authorCol}repeat(${calls.length}, 44px)`;

// Row 1 is the head. Each turn starts on the row after the rows of the
// turn before it, so a turn cell can span its rows.
let at = 2;
const turnRows = turns.map((t) => {
  const start = at;
  at += t.rows.length;
  return { turn: t, start };
});
const lastRow = at - 1;
---

<Figure alt={alt} caption={caption}>
  <CallCode code={call} />
  <div class="trace" style={`grid-template-columns:${cols}`}>
    <div class="th" style="grid-area:1/1;padding-left:2px">turn</div>
    <div class="th" style="grid-area:1/2">{entryLabel}</div>
    {hasAuthor && <div class="th" style="grid-area:1/3">{authorLabel}</div>}
    {
      calls.map((_, c) => (
        <div class="th c" style={`grid-area:1/${first + c}`}>
          call {c + 1}
        </div>
      ))
    }

    {
      turnRows.map(({ turn, start }) => (
        <>
          <div
            class:list={["turn", { last: start + turn.rows.length - 1 === lastRow }]}
            style={`grid-row:${start}/span ${turn.rows.length};grid-column:1`}
          >
            <b>{turn.label}</b>
          </div>
          {turn.rows.map((row, i) => {
            const r = start + i;
            const last = r === lastRow;
            return (
              <>
                <div class:list={["cell", { last }]} style={`grid-area:${r}/2`}>
                  <span class="ent">
                    <span class={`id k-${row.kind}`}>{row.id}</span>
                    {row.who && <span class="who">{row.who}</span>}
                    {row.text && <span class="txt">{row.text}</span>}
                    {row.chips?.map(([text, kind]) => (
                      <span class={`chip k-${kind}`}>{text}</span>
                    ))}
                    {row.stop && <span class="stop">{row.stop}</span>}
                  </span>
                </div>
                {hasAuthor && (
                  <div class:list={["cell", "w", { last }]} style={`grid-area:${r}/3`}>
                    <span class="plus">+</span>
                    {row.author}
                  </div>
                )}
              </>
            );
          })}
        </>
      ))
    }

    {
      written.map((w, c) => {
        const final = c === calls.length - 1;
        return (
          <>
            {w > 0 && (
              <div class="rd" style={`grid-row:2/span ${w};grid-column:${first + c}`}>
                <span class:list={["bar", { early: !final }]} />
              </div>
            )}
            <div class="rd" style={`grid-row:${2 + w};grid-column:${first + c}`}>
              <span class:list={["out", { early: !final }]}>→ {calls[c]}</span>
            </div>
          </>
        );
      })
    }
  </div>
  {Astro.slots.has("default") && <div class="note"><slot /></div>}
</Figure>

<style>
  .trace {
    display: grid;
    font-family: var(--font-mono);
    font-size: 11.5px;
  }
  .th {
    font-size: 10.5px;
    color: var(--muted);
    padding: 0 8px 6px;
    border-bottom: 1px solid var(--line-strong);
  }
  .th.c {
    text-align: center;
    padding: 0 0 6px;
    font-size: 10px;
  }
  .turn {
    border-bottom: 1px solid var(--line);
    border-right: 1px solid var(--line);
    padding: 8px 0 0 2px;
    color: var(--muted);
    font-size: 10.5px;
  }
  .turn b {
    display: block;
    color: var(--text);
    font-weight: 600;
    font-size: 11px;
  }
  .cell {
    border-bottom: 1px solid var(--line);
    padding: 6px 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
  }
  .last {
    border-bottom: none;
  }
  .ent {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    min-width: 0;
  }
  .id {
    font-size: 10.5px;
    font-weight: 600;
    padding: 0 5px;
    border-radius: 5px;
    border: 1px solid var(--k);
    background: color-mix(in srgb, var(--k) var(--l-mix), var(--code-bg));
  }
  .id.k-user {
    background: var(--code-bg);
  }
  .who {
    color: var(--muted);
    font-size: 10.5px;
  }
  .txt {
    color: var(--text);
  }
  .stop {
    color: var(--link);
    font-size: 10.5px;
  }
  .w {
    gap: 0;
    font-size: 10.5px;
    color: var(--muted);
    white-space: nowrap;
  }
  .plus {
    color: var(--primary);
    font-weight: 700;
    margin-right: 4px;
  }
  .rd {
    display: flex;
    justify-content: center;
  }
  .bar {
    width: 4px;
    border-radius: 2px;
    background: var(--primary);
    margin: 8px 0;
  }
  .bar.early {
    background: var(--muted-soft);
  }
  .out {
    align-self: center;
    font-size: 10px;
    color: var(--link);
    white-space: nowrap;
  }
  .out.early {
    color: var(--muted);
  }
  .note {
    margin-top: 14px;
    font-family: var(--font-prose);
    font-size: 12.5px;
    color: var(--copy);
  }
  .note :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--text);
  }
</style>
