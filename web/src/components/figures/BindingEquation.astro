---
// A binding equation: two or more cards joined with a plus sign, then an
// equals sign and the card of the result. Each term lists what it holds.
// The result lists the calls that it gets: a solid socket for a call
// that it always has, and a dashed socket for a call that depends on a
// term. Use it when a type is the sum of its parts.
import Figure from "./Figure.astro";

interface Term {
  type: string;
  // fields are what the term holds.
  fields: string[];
  // lacks names what the term does not hold, in the muted voice.
  lacks?: string;
  // example is one value of the term.
  example: string;
  // wire colors the term as a provider.
  wire?: boolean;
}

interface Call {
  name: string;
  // when says when the result has the call, such as "always".
  when: string;
  // always draws a solid socket. Other calls take a dashed socket.
  always?: boolean;
}

interface Props {
  alt: string;
  caption?: string;
  terms: Term[];
  result: { type: string; sub?: string; calls: Call[]; example: string };
}

const { alt, caption, terms, result } = Astro.props;

const columns = [...terms.map(() => "1fr 18px"), "1.3fr"].join(" ");
---

<Figure alt={alt} caption={caption}>
  <div class="eq" style={`grid-template-columns:${columns}`}>
    {
      terms.map((t, i) => (
        <>
          <div class:list={["card", { wire: t.wire }]}>
            <span class="t">{t.type}</span>
            <div class="fields">
              {t.fields.map((f) => (
                <span>{f}</span>
              ))}
              {t.lacks && <span class="lacks">{t.lacks}</span>}
            </div>
            <span class="eg">{t.example}</span>
          </div>
          <span class="op">{i === terms.length - 1 ? "=" : "+"}</span>
        </>
      ))
    }
    <div class="card accent">
      <span class="t">
        {result.type}
        {result.sub && <small>{result.sub}</small>}
      </span>
      <div class="sockets">
        {
          result.calls.map((c) => (
            <div class:list={["sk", { cond: !c.always }]}>
              <i />
              <span>
                {c.name}
                <small>{c.when}</small>
              </span>
            </div>
          ))
        }
      </div>
      <span class="eg">{result.example}</span>
    </div>
  </div>
</Figure>

<style>
  .eq {
    display: grid;
    align-items: stretch;
    min-width: 520px;
    color: var(--text);
  }
  .op {
    align-self: center;
    justify-self: center;
    font-family: var(--font-mono);
    font-size: 18px;
    color: var(--muted);
  }
  .card {
    border: 1.2px solid var(--line-strong);
    background: var(--code-bg);
    border-radius: 12px;
    padding: 10px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .card.wire {
    border-color: var(--l-wire);
    background: color-mix(in srgb, var(--l-wire) var(--l-mix), var(--code-bg));
  }
  .card.accent {
    border: 2px solid var(--primary);
    background: color-mix(in srgb, var(--primary) 6%, var(--code-bg));
  }
  .t {
    font-weight: 600;
  }
  .t small {
    display: block;
    font-weight: 400;
    font-size: 11px;
    color: var(--copy);
  }
  .fields {
    display: grid;
    gap: 3px;
    align-content: start;
    font-size: 11px;
  }
  .fields span {
    border-left: 2px solid var(--line);
    padding-left: 7px;
    color: var(--copy);
  }
  .card.wire .fields span {
    border-left-color: color-mix(in srgb, var(--l-wire) 50%, var(--code-bg));
  }
  .fields .lacks,
  .card.wire .fields .lacks {
    border: 0;
    padding: 0;
    color: var(--muted);
  }
  .eg {
    font-size: 10.5px;
    color: var(--muted);
    border-top: 1px dashed var(--line);
    padding-top: 6px;
  }
  .sockets {
    display: grid;
    gap: 7px;
    align-content: start;
  }
  .sk {
    display: grid;
    grid-template-columns: 14px 1fr;
    gap: 7px;
    align-items: start;
    font-size: 11.5px;
    line-height: 1.3;
  }
  .sk i {
    width: 12px;
    height: 12px;
    margin-top: 1px;
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-faint);
  }
  .sk.cond i {
    background: none;
    border: 1.2px dashed var(--muted);
    box-shadow: none;
  }
  .sk small {
    display: block;
    font-size: 10.5px;
    color: var(--muted);
  }
  .sk.cond > span {
    color: var(--copy);
  }
</style>
