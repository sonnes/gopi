---
// Overrides Starlight's Pagination so the destination is read before the
// direction. Starlight prints "Previous" first and the page title under
// it; a reader deciding whether to click cares about the title, so the
// title goes on top and the direction becomes the caption.
//
// The first page of each layer has the sidebar label "Overview", so a
// link to one of them reads as the name of its group.
import { Icon } from "@astrojs/starlight/components";

const { dir, pagination, sidebar } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const isRtl = dir === "rtl";

type SidebarEntry = (typeof sidebar)[number];

/** The label of the innermost group that holds the link to href. */
function groupOf(entries: SidebarEntry[], href: string, label?: string): string | undefined {
  for (const item of entries) {
    if (item.type === "link") {
      if (item.href === href) return label;
      continue;
    }
    const found = groupOf(item.entries, href, item.label);
    if (found !== undefined) return found;
  }
  return undefined;
}

function titleOf(link: { href: string; label: string }): string {
  if (link.label !== "Overview") return link.label;
  return groupOf(sidebar, link.href) ?? link.label;
}
---

<nav class="pagination-links print:hidden" aria-label="Pagination" dir={dir}>
  {
    prev && (
      <a href={prev.href} rel="prev">
        <span class="link-title">{titleOf(prev)}</span>
        <span class="direction">
          <Icon name={isRtl ? "right-caret" : "left-caret"} size="0.9rem" />
          Previous
        </span>
      </a>
    )
  }
  {
    next && (
      <a href={next.href} rel="next">
        <span class="link-title">{titleOf(next)}</span>
        <span class="direction">
          <Icon name={isRtl ? "left-caret" : "right-caret"} size="0.9rem" />
          Next
        </span>
      </a>
    )
  }
</nav>

<style>
  .pagination-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: 0.8rem;
  }

  a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.85rem 1.05rem;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--panel);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  a:hover {
    border-color: var(--line-strong);
  }

  .link-title {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
  }
  .direction {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* The next card mirrors: text to the trailing edge, arrow after it. */
  [rel="next"] {
    text-align: end;
    align-items: flex-end;
  }
  [rel="next"] .direction {
    flex-direction: row-reverse;
  }
</style>
